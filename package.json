    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nekorc/dsh-auto-review-zh.git"
  },
  "homepage": "https://github.com/nekorc/dsh-auto-review-zh#readme",
  "bugs": {
    "url": "https://github.com/nekorc/dsh-auto-review-zh/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
